{
  "name": "cyber-brotato",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "esbuild tests/run.test.ts --bundle --platform=node --format=esm --outfile=.test/run.test.mjs --log-level=error && node --test .test/run.test.mjs",
    "sim": "esbuild src/sim/balance.ts --bundle --platform=node --format=esm --outfile=.test/balance.mjs --log-level=error && node .test/balance.mjs"
  },
  "dependencies": {
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "esbuild": "^0.21.5",
    "@types/node": "^22.0.0"
  }
}
